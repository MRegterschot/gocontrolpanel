{
  "name": "tmcontrolpanel",
  "version": "0.12.0-beta",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins"
  ],
  "scripts": {
    "dev": "bun run --filter @tmcp/web dev",
    "dev:gbx": "bun run --filter @tmcp/gbx-service dev",
    "setup": "bun install && bun run deploy",
    "infra:up": "docker compose --env-file .env -f dev/docker-compose.yml up -d --wait redis mariadb",
    "infra:up:postgres": "docker compose --env-file .env -f dev/docker-compose.yml up -d --wait redis postgres",
    "infra:dedicated": "docker compose --env-file .env -f dev/docker-compose.yml up -d dedicated filemanager",
    "infra:down": "docker compose --env-file .env -f dev/docker-compose.yml --profile \"*\" down",
    "build": "bun --env-file=.env run --filter '*' build",
    "test": "bun --env-file=.env run --filter '*' test",
    "typecheck": "bun --env-file=.env run --filter '*' typecheck",
    "generate": "bun --env-file=.env run --filter @tmcp/db generate",
    "migrate": "bun --env-file=.env run --filter @tmcp/db migrate",
    "migrate:create": "bun --env-file=.env run --filter @tmcp/db migrate:create",
    "deploy": "bun --env-file=.env run --filter @tmcp/db deploy",
    "reset": "bun --env-file=.env run --filter @tmcp/db reset",
    "pretty": "prettier --write \"**/*.{ts,tsx,json,css}\""
  },
  "overrides": {
    "@radix-ui/react-focus-scope": "1.1.7"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5"
  }
}
