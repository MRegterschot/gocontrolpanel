{
  "name": "tmcontrolpanel",
  "version": "0.12.0-beta",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @tmcontrolpanel/web dev",
    "dev:gbx": "bun run --filter @tmcontrolpanel/gbx-service dev",
    "setup": "bun install && bun run deploy",
    "infra:up": "docker compose --env-file .env -f dev/docker-compose.yml up -d --wait redis mariadb",
    "infra:up:postgres": "docker compose --env-file .env -f dev/docker-compose.yml up -d --wait redis postgres",
    "infra:dedicated": "docker compose --env-file .env -f dev/docker-compose.yml up -d dedicated filemanager",
    "infra:down": "docker compose --env-file .env -f dev/docker-compose.yml --profile \"*\" down",
    "build": "bun --env-file=.env run --filter '*' build",
    "test": "bun --env-file=.env run --filter '*' test",
    "typecheck": "bun --env-file=.env run --filter '*' typecheck",
    "generate": "bun --env-file=.env run --filter @tmcontrolpanel/db generate",
    "migrate": "bun --env-file=.env run --filter @tmcontrolpanel/db migrate",
    "migrate:create": "bun --env-file=.env run --filter @tmcontrolpanel/db migrate:create",
    "deploy": "bun --env-file=.env run --filter @tmcontrolpanel/db deploy",
    "reset": "bun --env-file=.env run --filter @tmcontrolpanel/db reset",
    "pretty": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "encrypt:server-credentials": "bun --env-file=.env scripts/encrypt-server-credentials.ts"
  },
  "overrides": {
    "@radix-ui/react-focus-scope": "1.1.7",
    "fast-uri": "^3.1.8",
    "follow-redirects": "^1.16.1",
    "form-data": "^4.0.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5"
  }
}
