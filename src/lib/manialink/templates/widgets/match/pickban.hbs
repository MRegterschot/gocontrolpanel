{{#extend "widget"}}
{{#content "widget"}}
<frame id="pickban-action" pos="0 0">
  <quad pos="0 0" z-index="0" size="120 10" bgcolor="222"/>
  <label pos="5 -4.75" z-index="0" size="10 10" text="" halign="center" valign="center" textsize="2.5" textcolor="DDD" textfont="GameFontRegular"/>
  <label pos="12 -4.75" z-index="0" size="100 5" text="Marijn. is picking a map" valign="center" textcolor="DDD" textsize="1.75" textfont="GameFontSemiBold" />
</frame>

<framemodel id="map-info">
  <quad pos="0 0" z-index="0" size="10 10" bgcolor="222"/>
  <quad pos="10 0" z-index="0" size="90 10" bgcolor="DDD"/>
  <label pos="5 -4.5" z-index="0" size="10 10" text="" halign="center" valign="center" textsize="3" textcolor="DDD" textfont="GameFontBlack"/>
  <label pos="12 -5.25" z-index="0" size="41 5" text="-" textcolor="222" textsize="1.75" textfont="GameFontSemiBold" valign="bottom"/>
  <label pos="11.75 -5.5" z-index="0" size="41 5" text="-" textcolor="222" textprefix="$i" textfont="GameFontRegular" valign="top" textsize="1"/>

  <label pos="95 -4.75" z-index="0" size="41 5" text="" textcolor="222" textsize="1.75" textfont="GameFontSemiBold" valign="center" halign="right" />

  <quad class="trigger" pos="0 0" z-index="-2" size="100 10" bgcolor="000" opacity="0" scriptevents="1" />
</framemodel>

<frame id="maps" pos="0 -10" size="120 124">
<quad pos="0 {{ subtract (subtract 1159 (multiply (jsonLength data.mapInfosJson) 11.5)) 9 }}" size="120 1159" bgcolor="222" opacity="0.75" scriptevents="1"/>
{{#range 0 100}}
<frameinstance modelid="map-info" pos="5 {{ subtract (multiply i -11.5) 5 }}" />
{{/range}}
</frame>
{{/content}}


{{#content "globals"}}
#Struct MapInfo {
  Text name;
  Text author;
  Text uid;
  Integer index;
  Text[] selectedBy;
  Text pickedBy;
  Text bannedBy;
}

#Struct PickBanAction {
  Text action;
  Text login;
  Text[] players;
  Text nickName;
}
{{/content}}

{{#content "script"}}
Void updateScroll(Integer maps) {
  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);
  declare Integer mapCount = maps;
  if (mapCount > mapsFrame.Controls.count) {
    mapCount = mapsFrame.Controls.count;
  }
  declare Real maxY = mapCount * 11.5 - 115;
  declare CMlQuad mapsBackground <=> (mapsFrame.Controls[0] as CMlQuad);
  AnimMgr.Add(mapsBackground, "<quad pos='0 " ^ 1159 + mapCount * -11.5 - 9 ^ "' />", 600, CAnimManager::EAnimManagerEasing::ExpInOut);
  if (maxY < 0) {
    maxY = 0.;
  }
  mapsFrame.ScrollMax = <0., maxY>;
}

Void updateMapStatus(CMlFrame mapFrame, MapInfo map) {
  if (mapFrame.DataAttributeGet("pickedBy") != map.pickedBy) {
    mapFrame.DataAttributeSet("pickedBy", map.pickedBy);
    mapFrame.DataAttributeSet("position", TL::ToText(map.index));
    (mapFrame.Controls[2] as CMlLabel).SetText(TL::ToText(map.index));
    if (map.pickedBy == "random") {
      (mapFrame.Controls[5] as CMlLabel).SetText("Random");
    } else {
      (mapFrame.Controls[5] as CMlLabel).SetText("Picked by " ^ map.pickedBy);
    }
    AnimMgr.Add(mapFrame, "<frame pos='15 " ^ mapFrame.RelativePosition_V3.Y ^ "' />", 600, CAnimManager::EAnimManagerEasing::ExpInOut);
  }

  if (mapFrame.DataAttributeGet("bannedBy") != map.bannedBy) {
    mapFrame.DataAttributeSet("bannedBy", map.bannedBy);
    (mapFrame.Controls[2] as CMlLabel).SetText("");
    (mapFrame.Controls[5] as CMlLabel).SetText("Banned by " ^ map.bannedBy);
    (mapFrame.Controls[1] as CMlQuad).Opacity = 0.7;
  }

  if (map.bannedBy == "" && map.pickedBy == "") {
    if (map.selectedBy.count == 0) {
      (mapFrame.Controls[5] as CMlLabel).SetText("");
    } else {
      (mapFrame.Controls[5] as CMlLabel).SetText("" ^ map.selectedBy.count);
    }
  }
}

Void updateMapInfoRow(Integer index, MapInfo map, MapInfo[] maps) {
  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);

  if (index >= mapsFrame.Controls.count - 1) {
    return;
  }

  declare mapFrame <=> (mapsFrame.Controls[index + 1] as CMlFrame);

  if (mapFrame.DataAttributeGet("action") != "") {
    updateMapStatus(mapFrame, map);
    return;
  }

  (mapFrame.Controls[3] as CMlLabel).SetText(map.name);
  (mapFrame.Controls[4] as CMlLabel).SetText(map.author);

  mapFrame.DataAttributeSet("action", "{{ data.pickBanAction }}-" ^ map.uid);
  
  updateMapStatus(mapFrame, map);

  mapFrame.Show();
}

Void hideUnpickedMaps() {
  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);
  declare index = 0;

  while (index < mapsFrame.Controls.count - 1) {
    declare mapFrame <=> (mapsFrame.Controls[index + 1] as CMlFrame);
    if (mapFrame.DataAttributeGet("pickedBy") == "") {
      AnimMgr.Add(mapFrame, "<frame pos='-120 " ^ mapFrame.RelativePosition_V3.Y ^ "' />", 600, CAnimManager::EAnimManagerEasing::ExpInOut);
    } else {
      AnimMgr.Add(mapFrame, "<frame pos='10 " ^ mapFrame.RelativePosition_V3.Y ^ "' />", 600, CAnimManager::EAnimManagerEasing::ExpInOut);
    }
    index = index + 1;
  }
}

Void orderPickedMaps() {
  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);
  declare index = 0;
  
  while (index < mapsFrame.Controls.count - 1) {
    declare mapFrame <=> (mapsFrame.Controls[index + 1] as CMlFrame);
    if (mapFrame.DataAttributeGet("pickedBy") != "") {
      declare Integer position = TL::ToInteger(mapFrame.DataAttributeGet("position"));
      declare Real newY = 5 + (position - 1) * 11.5;
      AnimMgr.Add(mapFrame, "<frame pos='10 " ^ -newY ^ "' />", 600, CAnimManager::EAnimManagerEasing::ExpInOut);
    }
    index = index + 1;
  }
}

Integer getPickedMapsCount(MapInfo[] mapInfos) {
  declare Integer count = 0;
  foreach (map in mapInfos) {
    if (map.pickedBy != "") {
      count = count + 1;
    }
  }
  return count;
}

// Highlights (or unhighlights) the row at index. Deliberately does not call
// Control.Focus() - claiming engine focus is what causes Escape's first press
// to get consumed by our navigation scope instead of opening the pause menu.
// We track the selected row ourselves, so we don't need engine focus for it.
Void setRowHighlighted(Integer index, Boolean highlighted) {
  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);
  if (index < 0 || index >= mapsFrame.Controls.count - 1) {
    return;
  }

  declare mapFrame <=> (mapsFrame.Controls[index + 1] as CMlFrame);

  if (highlighted) {
    (mapFrame.Controls[1] as CMlQuad).BgColor = CL::Hex3ToRgb("999");
  } else {
    (mapFrame.Controls[1] as CMlQuad).BgColor = CL::Hex3ToRgb("DDD");
  }
}

Void scrollToRow(Integer index) {
  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);
  declare Real rowTop = index * 11.5;
  declare Real rowBottom = rowTop + 11.5;
  declare Real viewTop = mapsFrame.ScrollOffset.Y;
  // Matches the 10-row (115 = 10 * 11.5) window updateScroll's ScrollMax is
  // computed against, not the frame's own (taller) declared Size.Y - using
  // Size.Y here made rows near the bottom look "already visible" before the
  // real scroll bound would let them actually reach the bottom of the list.
  declare Real viewportHeight = 115.;
  declare Real viewBottom = viewTop + viewportHeight;

  if (rowTop < viewTop) {
    mapsFrame.ScrollOffset = <0., rowTop>;
  } else if (rowBottom > viewBottom) {
    mapsFrame.ScrollOffset = <0., rowBottom - viewportHeight>;
  }
}

// Clamps targetIndex to the map list bounds, without touching any visuals.
Integer clampMapIndex(MapInfo[] mapInfos, Integer targetIndex) {
  if (mapInfos.count == 0) {
    return -1;
  }

  declare Integer newIndex = targetIndex;
  if (newIndex < 0) {
    newIndex = 0;
  } else if (newIndex >= mapInfos.count) {
    newIndex = mapInfos.count - 1;
  }

  return newIndex;
}

// Moves the highlight/focus/scroll from previousIndex to newIndex.
Void applySelection(Integer previousIndex, Integer newIndex) {
  if (previousIndex != newIndex) {
    setRowHighlighted(previousIndex, False);
  }
  setRowHighlighted(newIndex, True);
  scrollToRow(newIndex);
}

// Moves the selection by delta, or - on the first interaction, when nothing is
// visibly selected yet - just reveals the current position without moving it.
// Returns the new selected index.
Integer navigateSelection(MapInfo[] mapInfos, Integer currentIndex, Boolean selectionVisible, Integer delta) {
  declare Integer targetIndex = currentIndex;
  if (selectionVisible) {
    targetIndex = currentIndex + delta;
  }

  declare Integer newIndex = clampMapIndex(mapInfos, targetIndex);
  applySelection(currentIndex, newIndex);
  return newIndex;
}

// Triggers the pick/ban action of the currently selected row, same as clicking it.
Void triggerSelectedMap(MapInfo[] mapInfos, Integer selectedIndex) {
  if (mapInfos.count == 0 || selectedIndex < 0) {
    return;
  }

  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);
  declare mapFrame <=> (mapsFrame.Controls[selectedIndex + 1] as CMlFrame);
  declare Text action = mapFrame.DataAttributeGet("action");
  if (action != "") {
    TriggerPageAction(action);
  }
}

Integer updateWidget(MapInfo[] mapInfos, PickBanAction currentAction, Integer selectedIndex, Boolean selectionVisible) {
  declare mapsCount = mapInfos.count;
  declare index = 0;

  foreach (map in mapInfos) {
    updateMapInfoRow(index, map, mapInfos);
    index = index + 1;
  }

  declare mapsFrame <=> (Page.MainFrame.GetFirstChild("maps") as CMlFrame);

  // Hide unused rows
  while (index < mapsFrame.Controls.count - 1) {
    declare mapFrame <=> (mapsFrame.Controls[index + 1] as CMlFrame);
    mapFrame.DataAttributeSet("action", "");
    mapFrame.Hide();
    index = index + 1;
  }
  
  updateScroll(mapInfos.count);
  declare Integer newSelectedIndex = clampMapIndex(mapInfos, selectedIndex);
  if (selectionVisible) {
    applySelection(selectedIndex, newSelectedIndex);
  }

  declare actionFrame <=> (Page.MainFrame.GetFirstChild("pickban-action") as CMlFrame);
  declare actionLabel <=> (actionFrame.Controls[2] as CMlLabel);
  if (currentAction.action == "pick") {
    actionLabel.SetText(currentAction.nickName ^ "$z is picking a map");
  } else if (currentAction.action == "ban") {
    actionLabel.SetText(currentAction.nickName ^ "$z is banning a map");
  } else if (currentAction.action == "random") {
    actionLabel.SetText("Random map is being picked");
  } else {
    actionLabel.SetText("Pick and ban completed");
    sleep(5000);
    hideUnpickedMaps();
    mapsFrame.ScrollMax = <0., 0.>;
    sleep(400);
    updateScroll(getPickedMapsCount(mapInfos));
    orderPickedMaps();
  }

  return newSelectedIndex;
}
{{/content}}

{{#content "main"}}
declare MapInfo[] MapInfos for This;
declare PickBanAction CurrentAction for This;
declare Integer LastPickBanUpdate for This = -1;
declare Integer lastUpdate = -1;
declare Integer SelectedMapIndex = -1;
declare Boolean SelectionVisible = False;
declare mapsFrame <=> (widget.GetFirstChild("maps") as CMlFrame);
mapsFrame.ScrollActive = True;
mapsFrame.ScrollMin = <0., 0.>;
mapsFrame.ScrollGrid = <0., 11.5>;
{{/content}}


{{#content "loop"}}
if (LastPickBanUpdate != lastUpdate) {
  lastUpdate = LastPickBanUpdate;
  SelectedMapIndex = updateWidget(MapInfos, CurrentAction, SelectedMapIndex, SelectionVisible);
}

// Up/Down: read from Input.PendingEvents rather than polling KeyUp/KeyDown -
// the keyboard is itself a "Pad" (EPadType::Keyboard) in this input system, so
// arrow presses show up here too, and polling both doubled every move. This is
// a separate, lower-level raw input queue (not the manialink page's own
// CMlScript.PendingEvents), so reading it doesn't need EnableMenuNavigation and
// doesn't touch scroll-wheel/Escape at all. Covers both keyboard and gamepad.
foreach (padEvent in Input.PendingEvents) {
  if (padEvent.Type != CInputEvent::EType::PadButtonPress || padEvent.IsAutoRepeat) continue;

  if (padEvent.Button == CInputEvent::EButton::Up || padEvent.Button == CInputEvent::EButton::LeftStick_Up) {
    SelectedMapIndex = navigateSelection(MapInfos, SelectedMapIndex, SelectionVisible, -1);
    SelectionVisible = True;
  } else if (padEvent.Button == CInputEvent::EButton::Down || padEvent.Button == CInputEvent::EButton::LeftStick_Down) {
    SelectedMapIndex = navigateSelection(MapInfos, SelectedMapIndex, SelectionVisible, 1);
    SelectionVisible = True;
  } else if (padEvent.Button == CInputEvent::EButton::A) {
    if (SelectionVisible) {
      triggerSelectedMap(MapInfos, SelectedMapIndex);
    }
  }
}
{{/content}}

{{#content "events"}}
if (event.Control.HasClass("trigger") && event.Type == CMlScriptEvent::Type::MouseClick) {
  declare action = event.Control.Parent.DataAttributeGet("action");
  if (action != "") {
    TriggerPageAction(action);
  }
}
{{/content}}
