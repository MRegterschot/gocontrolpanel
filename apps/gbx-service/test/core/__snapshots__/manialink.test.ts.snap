<script><!--
#Include "MathLib" as ML
#Include "TextLib" as TL
#Include "TimeLib" as TimeLib
#Include "ColorLib" as CL

#Struct Team {
  Text mainColor;
  Text secondaryColor;
  Text textColor;
}

#Struct Round {
  Text login;
  Text name;
  Integer rank;
  Integer points;
  Integer[] checkpoints;
  Integer time;
  Team team;
}

#Struct Finish {
  Text login;
  Integer points;
  Boolean isPersonalBest;
  Boolean isLocalRecord;
  Boolean isWorldRecord;
}


declare CMlFrame widget;
--></script>

<script><!--
declare Vec2 widgetBasePosition;
declare CMlFrame HS_Target;
declare Boolean HS_Hidden;

Void hs_hide(Integer duration) {
  HS_Hidden = True;
  declare Real x;
  if (widgetBasePosition[0] < 0.0) {
    x = (HS_Target.Size[0] * -HS_Target.RelativeScale) - 322.0;
  } else {
    x = 322.0;
  }
  AnimMgr.Add(HS_Target, "<frame pos='" ^ x ^ " " ^ widgetBasePosition[1] ^ "' />", duration, CAnimManager::EAnimManagerEasing::ExpInOut);
}

Void hs_show(Integer duration) {
  HS_Hidden = False;
  AnimMgr.Add(HS_Target, "<frame pos='" ^ widgetBasePosition[0] ^ " " ^ widgetBasePosition[1] ^ "' />", duration, CAnimManager::EAnimManagerEasing::CircOut);
}

Void hidescript() {
  if (HS_Target == Null){
    HS_Target <=> (Page.MainFrame.GetFirstChild("widget") as CMlFrame);
  }

  declare hideSpeed = 10;

  if (InputPlayer == Null) {
    if (HS_Hidden) {
      hs_show(600);
    }
    return;
  }

  declare Boolean overHidespeed = ML::Abs(InputPlayer.Speed * 3.6) > hideSpeed;

  if (overHidespeed && !HS_Hidden) {
    hs_hide(1000);

    while(InputPlayer.Speed * 3.6 > hideSpeed){
      yield;
      hidescript();
    }
  }
  
  if (!overHidespeed && HS_Hidden) {
    sleep(1000);
    hs_show(600);
  }
}
--></script>
<script><!--
Text formatTime(Integer time) {
  declare Text secondString;
  declare Text msString;

  if (time < 0) {
    return "--:--.---";
  }

  declare Integer seconds = time / 1000;
  declare Integer minutes = seconds / 60;
  declare Integer milliseconds = time - (seconds * 1000);
  seconds = seconds - (minutes * 60);

  secondString = TL::ToText(seconds);

  if (seconds < 10) {
    secondString = "0" ^ secondString;
  }

  if (milliseconds <= 0) {
    msString = "000";
  } else if (milliseconds < 10) {
    msString = "00" ^ TL::ToText(milliseconds);
  } else if (milliseconds < 100) {
    msString = "0" ^ TL::ToText(milliseconds);
  } else {
    msString = TL::ToText(milliseconds);
  }

  if (minutes > 0) {
    return TL::ToText(minutes) ^ ":" ^ secondString ^ "." ^ msString;
  } else {
    return secondString ^ "." ^ msString;
  }

  return "";
}

// Computes the checkpoint gap to the leader for every round, in rounds order.
// Mirrors the Delta/MinDelta approach used to rank live players by checkpoint:
// each player's gap is compared against the leader at their last reached checkpoint
// (falling back to the leader's next checkpoint if the leader is already past it),
// then clamped to never be smaller than the running gap of players ahead of them.
Integer[] getCheckpointGaps(Round[] rounds) {
  declare Integer[] gaps = Integer[];

  if (rounds.count == 0) {
    return gaps;
  }

  declare Round firstPlaceRound = rounds[0];

  // The furthest checkpoint time reached by anyone currently racing
  declare Integer GlobalLastCPTime = -1;
  foreach (round in rounds) {
    if (round.checkpoints.count == 0) continue;

    declare Integer lastTime = round.checkpoints[round.checkpoints.count - 1];
    if (lastTime > GlobalLastCPTime) {
      GlobalLastCPTime = lastTime;
    }
  }

  declare Integer MinDelta = 0;
  declare Integer Index = 0;
  foreach (round in rounds) {
    declare Integer Delta = 0;

    if (Index != 0 && round.checkpoints.count > 0) {
      declare Integer lastCheckpointIndex = round.checkpoints.count - 1;
      declare Integer playerCheckpointTime = round.checkpoints[lastCheckpointIndex];

      if (firstPlaceRound.checkpoints.count > lastCheckpointIndex + 1) {
        // Leader already reached the next checkpoint -> also compare against that
        Delta = ML::Max(
          playerCheckpointTime - firstPlaceRound.checkpoints[lastCheckpointIndex],
          GlobalLastCPTime - firstPlaceRound.checkpoints[lastCheckpointIndex + 1]
        );
      } else if (firstPlaceRound.checkpoints.count > lastCheckpointIndex) {
        Delta = playerCheckpointTime - firstPlaceRound.checkpoints[lastCheckpointIndex];
      }
    }

    // The gap can never shrink compared to players ahead in the ranking
    if (Delta > MinDelta) {
      MinDelta = Delta;
    } else {
      Delta = MinDelta;
    }

    gaps.add(Delta);
    Index += 1;
  }

  return gaps;
}

Text getTimeDiffText(Round playerRound, Integer checkpointGap) {
  if (playerRound.login == "") {
    return "--:--.---";
  }

  // If the player's time is -1, return DNF
  if (playerRound.time == -1) {
    return "DNF";
  }

  // If the player has no checkpoints, return --:--.---
  if (playerRound.checkpoints.count == 0) {
    return "--:--.---";
  }

  // If the player is rank 1, return their time
  if (playerRound.rank == 1) {
    return formatTime(playerRound.time);
  }

  return "+" ^ formatTime(checkpointGap);
}

Void updateRoundRow(Integer index, Round round, Integer checkpointGap, Text mode, Integer pointsLimit) {
  declare roundsFrame <=> (Page.MainFrame.GetFirstChild("rounds") as CMlFrame);

  if (index >= roundsFrame.Controls.count) {
    return;
  }

  declare roundFrame <=> (roundsFrame.Controls[index + 1] as CMlFrame);
  (roundFrame.Controls[3] as CMlLabel).SetText(TL::ToText(round.rank));
  (roundFrame.Controls[4] as CMlQuad).ChangeImageUrl("file://ZoneFlags/Login/" ^ round.login ^ "/country");
  (roundFrame.Controls[5] as CMlLabel).SetText(round.name);

  declare Text pointsText = TL::ToText(round.points);
  if (mode == "cup" && pointsLimit > 0) {
    if (round.points > pointsLimit) {
      pointsText = "$2C2W";
    } else if (round.points == pointsLimit) {
      pointsText = "$D22F";
    }
  } else if (mode == "rounds" && pointsLimit > 0) {
    if (round.points >= pointsLimit && round.team.mainColor == "") {
      pointsText = "$2C2W";
    }
  } else if (mode == "reversecup") {
    if (-2000 < round.points && round.points <= -1000) {
      pointsText = "$D22LC";
    } else if (round.points <= -2000) {
      pointsText = "$D22E";
    }
  }

  (roundFrame.Controls[6] as CMlLabel).SetText(pointsText);
  (roundFrame.Controls[7] as CMlLabel).SetText(getTimeDiffText(round, checkpointGap));
  roundFrame.DataAttributeSet("login", round.login);

  if (round.team.mainColor != "") {
    (roundFrame.Controls[0] as CMlQuad).BgColor = CL::Hex3ToRgb(round.team.mainColor);
    (roundFrame.Controls[1] as CMlQuad).BgColor = CL::Hex3ToRgb(round.team.secondaryColor);
    (roundFrame.Controls[2] as CMlQuad).BgColor = CL::Hex3ToRgb(round.team.mainColor);
    (roundFrame.Controls[4] as CMlQuad).BgColor = CL::Hex3ToRgb(round.team.secondaryColor);
    (roundFrame.Controls[5] as CMlLabel).TextColor = CL::Hex3ToRgb(round.team.textColor);
    (roundFrame.Controls[6] as CMlLabel).TextColor = CL::Hex3ToRgb(round.team.textColor);
    (roundFrame.Controls[7] as CMlLabel).TextColor = CL::Hex3ToRgb(round.team.textColor);
  } else {
    (roundFrame.Controls[0] as CMlQuad).BgColor = CL::Hex3ToRgb("222");
    (roundFrame.Controls[1] as CMlQuad).BgColor = CL::Hex3ToRgb("DDD");
    (roundFrame.Controls[2] as CMlQuad).BgColor = CL::Hex3ToRgb("BBB");
    (roundFrame.Controls[4] as CMlQuad).BgColor = CL::Hex3ToRgb("DDD");
    (roundFrame.Controls[5] as CMlLabel).TextColor = CL::Hex3ToRgb("222");
    (roundFrame.Controls[6] as CMlLabel).TextColor = CL::Hex3ToRgb("222");
    (roundFrame.Controls[7] as CMlLabel).TextColor = CL::Hex3ToRgb("222");
  }

  roundFrame.Show();
}

Void updateFinish(Text login, Integer points, Boolean finished, Boolean isPersonalBest, Boolean isLocalRecord, Boolean isWorldRecord, Text localRecordText) {
  declare roundsFrame <=> (Page.MainFrame.GetFirstChild("rounds") as CMlFrame);

  foreach (control in roundsFrame.Controls) {
    // Skip first control (invisible background quad)
    if (control == roundsFrame.Controls[0]) {
      continue;
    }

    declare roundFrame <=> (control as CMlFrame);
    declare Text frameLogin = roundFrame.DataAttributeGet("login");

    if (frameLogin == login) {
      declare frameFinish <=> (roundFrame.GetFirstChild("finish") as CMlFrame);

      AnimMgr.Flush(frameFinish);
      
      if (finished) {
        if (points == 0) {
          (frameFinish.Controls[1] as CMlLabel).SetText("");
        } else {
          declare Text pointsText = "+" ^ TL::ToText(points);
          if (points < 0) {
            pointsText = "-" ^ TL::ToText(-points);
          }
          
          (frameFinish.Controls[1] as CMlLabel).SetText(pointsText);
        }

        if (isPersonalBest) {
          (frameFinish.Controls[3] as CMlLabel).SetText("PB");
        } 
        
        if (isLocalRecord) {
          (frameFinish.Controls[3] as CMlLabel).SetText(localRecordText);
        }
        
        if (isWorldRecord) {
          (frameFinish.Controls[3] as CMlLabel).SetText("WR");
        }

        if (isWorldRecord || isLocalRecord || isPersonalBest) {
          (frameFinish.Controls[2] as CMlQuad).Show();
          (frameFinish.Controls[3] as CMlLabel).Show();
        } else {
          (frameFinish.Controls[2] as CMlQuad).Hide();
          (frameFinish.Controls[3] as CMlLabel).Hide();
        }
        
        AnimMgr.Add(frameFinish, """<frame pos='55 0' />""", 600, CAnimManager::EAnimManagerEasing::ExpInOut);
      } else {
        AnimMgr.Add(frameFinish, """<frame pos='47.5 0' />""", 600, CAnimManager::EAnimManagerEasing::ExpInOut);
        (frameFinish.Controls[2] as CMlQuad).Hide();
        (frameFinish.Controls[3] as CMlLabel).Hide();
      }

      break;
    }
  }
}

Void clearFinishes(Round[] rounds, Text localRecordText) {
  foreach (round in rounds) {
    updateFinish(round.login, 0, False, False, False, False, localRecordText);
  }
}

Void updateScroll(Round[] rounds, Integer rowCount) {
  declare roundsFrame <=> (Page.MainFrame.GetFirstChild("rounds") as CMlFrame);
  declare Integer roundCount = rounds.count;
  if (roundCount > roundsFrame.Controls.count) {
    roundCount = roundsFrame.Controls.count;
  }
  declare Real maxY = (roundCount - rowCount) * 5.25;
  if (maxY < 0) {
    maxY = 0.;
  }
  roundsFrame.ScrollMax = <0., maxY>;
  roundsFrame.Size = <69., rowCount * 5.25>;
}

Void updateWidget(Round[] rounds, Text mode, Integer pointsLimit, Integer rowCount) {
  declare roundCount = rounds.count;
  declare index = 0;

  declare Integer[] checkpointGaps = getCheckpointGaps(rounds);

  foreach (round in rounds) {
    updateRoundRow(index, round, checkpointGaps[index], mode, pointsLimit);
    index = index + 1;
  }

  declare roundsFrame <=> (Page.MainFrame.GetFirstChild("rounds") as CMlFrame);
  // Hide unused rows
  while (index < roundsFrame.Controls.count - 1) {
    declare roundFrame <=> (roundsFrame.Controls[index + 1] as CMlFrame);
    roundFrame.DataAttributeSet("login", "");
    roundFrame.Hide();
    index = index + 1;
  }

  updateScroll(rounds, rowCount);
}

--></script>

<script><!--
main() {
  widget <=> (Page.MainFrame.GetFirstChild("widget") as CMlFrame);
  widgetBasePosition = widget.AbsolutePosition_V3;

  sleep(300);
  widget.Show();

  declare Round[] Rounds for This;
declare Finish[] Finishes for This = [];
declare Text Mode for This = "rounds";
declare Text localRecordText for This;
declare Integer rowCount for This;
declare Integer PointsLimit for This = -1;
declare Integer LastRoundsUpdate for This = -1;
declare Integer lastUpdate = -1;
declare Finish[] prevFinishes = [];
declare roundsFrame <=> (widget.GetFirstChild("rounds") as CMlFrame);
roundsFrame.ScrollActive = True;
roundsFrame.ScrollMin = <0., 0.>;


  while (True) {
    yield;

    foreach(event in PendingEvents){
      if(event.Control == Null) continue;

      if (event.Control.HasClass("trigger") && event.Type == CMlScriptEvent::Type::MouseClick) {
  declare targetLogin = event.Control.Parent.DataAttributeGet("login");
  if (targetLogin != "") {
    SetSpectateTarget(targetLogin);
  }
}

    }

    if (LastRoundsUpdate != lastUpdate) {
  lastUpdate = LastRoundsUpdate;
  
  updateWidget(Rounds, Mode, PointsLimit, rowCount);

  if (Finishes.count == 0) {
    clearFinishes(Rounds, localRecordText);
  }

  if (Finishes.count != prevFinishes.count) {
    if (Finishes.count > prevFinishes.count) {
      // Find newly finished players
      foreach (finish in Finishes) {
        declare Boolean found = False;
        foreach (prevFinish in prevFinishes) {
          if (finish.login == prevFinish.login) {
            found = True;
            break;
          }
        }

        if (!found) {
          updateFinish(finish.login, finish.points, True, finish.isPersonalBest, finish.isLocalRecord, finish.isWorldRecord, localRecordText);
        }
      }
    } else {
      clearFinishes(Rounds, localRecordText);
      // Re-apply finished players
      foreach (finish in Finishes) {
        updateFinish(finish.login, finish.points, True, finish.isPersonalBest, finish.isLocalRecord, finish.isWorldRecord, localRecordText);
      }
    }
  }

  prevFinishes = Finishes;
}


      hidescript();
  }
}

--></script>

</manialink>
"
`;

exports[`TemplateRenderer > renders widgets/live-round/live-round-update 1`] = `
