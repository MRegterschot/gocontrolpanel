{
  "name": "@tmcp/gbx-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../plugins build && tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/main.ts | pino-pretty",
    "build": "tsup && bun run --cwd ../../plugins build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e:up": "docker compose --env-file e2e/.env -f e2e/docker-compose.yml up -d",
    "e2e:down": "docker compose --env-file e2e/.env -f e2e/docker-compose.yml down",
    "e2e:migrate": "cd ../../packages/db && DB=mysql bun --env-file=../../apps/gbx-service/e2e/.env run migrate:deploy",
    "e2e:seed": "tsx --env-file=e2e/.env scripts/seed-e2e.ts",
    "e2e:dev": "tsx watch --env-file=e2e/.env src/main.ts | pino-pretty",
    "ws:watch": "tsx --env-file=e2e/.env scripts/ws-watch.ts"
  },
  "dependencies": {
    "@evotm/gbxclient": "^1.5.0",
    "@fastify/websocket": "^11.3.1",
    "@tmcp/db": "workspace:*",
    "@tmcp/shared": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@prisma/client": "^6.8.2",
    "@sentry/node": "^10",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.8",
    "handlebars-layouts": "^3.1.4",
    "ioredis": "^5.6.1",
    "pino": "^10.3.1",
    "quickjs-emscripten-core": "0.32.0",
    "slugid": "^5.0.1",
    "tmtags": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tmcontrolpanel/plugin-sdk": "workspace:*",
    "@types/node": "^20",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "ws": "^8.18.3"
  }
}
