# Reference for this app. In the monorepo the root .env.example covers both apps (see CONTRIBUTING.md);
# use this file when running the service on its own. Values match the stack from `bun run infra:up`.

# Same database and Redis as the web app
DATABASE_URL="mysql://root:root@localhost:3306/gocontrolpanel"
# PostgreSQL (bun run infra:up:postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gocontrolpanel"
REDIS_URI="redis://localhost:6379"

PORT=3100
LOG_LEVEL="debug"

# Shared with the web app: bearer token for /internal routes (min. 32 chars)
GBX_SERVICE_TOKEN="dev-service-token-change-me-0123456789"
# Shared with the web app: signs the short-lived WebSocket tickets (min. 32 chars)
WS_TICKET_SECRET="dev-ticket-secret-change-me-0123456789"
# Browser origins allowed to open sockets, comma separated (empty allows any)
WS_ALLOWED_ORIGINS="http://localhost:3000"

# Codriver: where the service reaches the panel for /co chat commands; empty turns /co off
PANEL_INTERNAL_URL="http://localhost:3000"
PANEL_INTERNAL_TOKEN="dev-panel-token-change-me-0123456789"

# Limit which server ids this container may claim (comma separated); empty allows all.
# Cluster workers sharing Redis coordinate ownership through leases.
GBX_SERVICE_ENABLED_SERVERS=""

# Worker processes that hold the GBX connections. A crashed worker only takes down its own
# servers; set it to the server count for one process per server. 0 runs everything in one process.
GBX_WORKERS=1
# Unique per container when several hosts share the database and Redis (default: hostname)
GBX_NODE_ID=""
# Lease lifetime in milliseconds (minimum 6000); renewed every TTL/3.
GBX_LEASE_TTL_MS=15000

# Nadeo API (world records, personal bests, map metadata, account names). Optional: without it
# those widgets stay empty. Use the same values as the web app.
NADEO_SERVER_LOGIN=""
NADEO_SERVER_PASSWORD=""
NADEO_CONTACT="TMControlPanel / <your contact info>"
NADEO_CLIENT_ID=""
NADEO_CLIENT_SECRET=""

SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
