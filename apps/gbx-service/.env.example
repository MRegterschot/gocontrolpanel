# Same database and Redis as the web app
DATABASE_URL="postgresql://gocontrolpanel:VettePanel123@localhost:5432/gocontrolpanel"
REDIS_URI="redis://localhost:6379"

PORT=3100
LOG_LEVEL="info"

# Shared with the web app: bearer token for /internal routes (min. 32 chars)
GBX_SERVICE_TOKEN=""
# Shared with the web app: signs the short-lived WebSocket tickets (min. 32 chars)
WS_TICKET_SECRET=""
# Browser origins allowed to open sockets, comma separated (empty allows any)
WS_ALLOWED_ORIGINS="http://localhost:3000"

# Only manage these server ids (comma separated); empty manages all servers.
# Useful while the web app still runs its own GBX connections.
GBX_SERVICE_ENABLED_SERVERS=""

# Nadeo API (world records, personal bests, map metadata, account names)
NADEO_SERVER_LOGIN=""
NADEO_SERVER_PASSWORD=""
NADEO_CONTACT="GoControlPanel / <your contact info>"
NADEO_CLIENT_ID=""
NADEO_CLIENT_SECRET=""

SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
