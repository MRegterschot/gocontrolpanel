# Dedicated server account (https://www.trackmania.com/player/dedicated-servers)
TM_MASTERSERVER_LOGIN=
TM_MASTERSERVER_PASSWORD=

# XML-RPC as seen from the service running on your machine
E2E_GBX_PORT=5010
E2E_GBX_PASSWORD=SuperAdmin
E2E_GAME_PORT=2350

# Your Trackmania login: becomes server admin, match admin and ECM editor
E2E_ADMIN_LOGIN=

# GBX service (bun run dev:gbx with this file: see docs/real-server-testing.md)
DATABASE_URL=mysql://gcp:gcp@localhost:53307/gcp_e2e
REDIS_URI=redis://localhost:56380
PORT=3101
LOG_LEVEL=debug
GBX_SERVICE_TOKEN=e2e-service-token-0123456789abcdefghij
WS_TICKET_SECRET=e2e-ticket-secret-0123456789abcdefghij
GBX_SERVICE_ENABLED_SERVERS=e2e-server

# Optional, enables world records, personal bests, map metadata and account names
NADEO_SERVER_LOGIN=
NADEO_SERVER_PASSWORD=
NADEO_CONTACT=GoControlPanel e2e
NADEO_CLIENT_ID=
NADEO_CLIENT_SECRET=
