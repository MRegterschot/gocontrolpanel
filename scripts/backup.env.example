# Copy to scripts/backup.env (not committed) and fill in what you use.
# DATABASE_URL is taken from the environment or the .env file in the repository root.

# Where dumps are kept on this machine (a leading ~ is expanded), and for how many days
BACKUP_DIR=/var/backups/gocontrolpanel
BACKUP_KEEP_DAYS=14

# Run the dump inside the database container (needed when DATABASE_URL points at the compose
# host "db", which only exists inside Docker). Leave empty to use mysqldump/pg_dump on this machine.
BACKUP_DB_CONTAINER=

# none | rsync | rclone
BACKUP_UPLOAD=none

# rsync over SSH: user@host:/absolute/path/  (the key must work without a passphrase prompt)
BACKUP_RSYNC_TARGET=
BACKUP_SSH_KEY=
BACKUP_SSH_PORT=22

# rclone: a remote you configured with `rclone config`, for example s3:my-bucket/gocontrolpanel
BACKUP_RCLONE_TARGET=

# Remove uploaded backups older than this many days (empty keeps them forever)
BACKUP_REMOTE_KEEP_DAYS=

# Encrypt the dump with AES-256 using the first line of this file as the passphrase.
# Keep a copy of the passphrase somewhere else, a backup you cannot decrypt is no backup.
BACKUP_ENCRYPT_PASSFILE=

# healthchecks.io style URL: pinged on success, and with /fail appended on failure
BACKUP_PING_URL=
