# Local development environment: cp .env.example .env
# Read by the root scripts (bun run dev, dev:gbx, deploy, ...) and by the infra:* scripts.

# Database flavour, must match DATABASE_URL: mysql (MariaDB) or postgres
DB="mysql"
DATABASE_URL="mysql://root:root@localhost:3306/gocontrolpanel"
# PostgreSQL instead (bun run infra:up:postgres):
# DB="postgres"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gocontrolpanel"

REDIS_URI="redis://localhost:6379"
LOG_LEVEL="debug"

# --- Web app
NEXTAUTH_URL="http://localhost:3000/"
# openssl rand -base64 32
NEXTAUTH_SECRET=""
# Your own Trackmania login: you become admin the first time you log in
DEFAULT_ADMINS=""
DEFAULT_PERMISSIONS=""
# Random string used to encrypt api keys stored in the database
HETZNER_KEY=""
NEXT_PUBLIC_SENTRY_ENABLED="false"

# Nadeo OAuth app, needed to log in: https://api.trackmania.com/manager
# Add NADEO_REDIRECT_URI to the app's redirect URLs
NADEO_CLIENT_ID=""
NADEO_CLIENT_SECRET=""
NADEO_REDIRECT_URI="http://localhost:3000/api/auth/callback/nadeo"
NADEO_CONTACT="GoControlPanel / <your contact info>"

# Dedicated server account: https://www.trackmania.com/player/dedicated-servers
# Required: the web app authenticates with Nadeo on startup and exits if this is wrong.
# Also used by the dedicated server container (bun run infra:dedicated)
NADEO_SERVER_LOGIN=""
NADEO_SERVER_PASSWORD=""

# --- GBX service (bun run dev:gbx)
# The web app and the service must share the token and the ticket secret (at least 32 characters each)
GBX_SERVICE_URL="http://localhost:3100"
GBX_SERVICE_WS_URL="ws://localhost:3100"
GBX_SERVICE_TOKEN="dev-service-token-change-me-0123456789"
WS_TICKET_SECRET="dev-ticket-secret-change-me-0123456789"
# Browser origins allowed to open sockets
WS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Codriver AI assistant (web app and GBX service), see docs/codriver-plan.md
# Where the GBX service reaches the panel for /co chat commands; empty turns /co off
PANEL_INTERNAL_URL="http://localhost:3000"
PANEL_INTERNAL_TOKEN="dev-panel-token-change-me-0123456789"
# Anthropic API key Codriver uses for every server; empty turns Codriver off
ANTHROPIC_API_KEY=""

# --- Plugin marketplace (web app and GBX service)
# Index the panel browses and the service checks for withdrawn versions; empty turns it off.
# Unset uses the official marketplace. For a local registry: bun packages/plugin-sdk/src/cli/main.ts
# registry --registry <dir> --out site, then serve site/ and point this at its index.json
# MARKETPLACE_INDEX_URL=""
# MARKETPLACE_CHECK_MINUTES="30"
